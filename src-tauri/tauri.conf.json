{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocuMind",
  "version": "0.1.0",
  "identifier": "com.documind.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocuMind",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Quan Nguyen",
    "copyright": "Copyright © 2026 Quan Nguyen",
    "category": "Productivity",
    "shortDescription": "Local-first OCR & document intelligence",
    "longDescription": "DocuMind converts PDFs, books, and scanned images into structured Markdown entirely on your machine — OCR and document processing happen locally, with no document content uploaded to the cloud.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["tesseract-ocr", "poppler-utils"]
      }
    }
  }
}
